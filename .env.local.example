# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/cleanloop?retryWrites=true&w=majority

# Long, random secret used to sign JWTs — generate with: openssl rand -base64 48
JWT_SECRET=replace-this-with-a-long-random-string

# Cookie name (optional override)
AUTH_COOKIE_NAME=cleanloop_token

# Set to "production" when deploying (enables Secure cookies)
NODE_ENV=development
